# LyricDeck v2 configuration. Copy to .env and fill in.
PORT=3000

# Spotify (optional, legacy source)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Genius annotations for trivia pop-ups (optional)
# Get a token at https://genius.com/api-clients (create an API client, use the access token)
GENIUS_ACCESS_TOKEN=

# Jellyfin (optional second source alongside Plex)
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_API_KEY=
